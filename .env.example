# ── Chiave di Claude (obbligatoria) ─────────────────────────────
# Creala su https://console.anthropic.com -> API Keys e imposta un tetto di spesa mensile.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Inviti (obbligatori) ────────────────────────────────────────
# Nome:codice separati da virgola. Codici di almeno 8 caratteri.
# Link da mandare: https://INDIRIZZO/entra?invito=CODICE
INVITI="Alfredo:mela-verde-2731"

# ── Facoltativi ─────────────────────────────────────────────────
# Segreto per firmare gli inviti sul telefono (su Render lo genera da solo).
# SESSION_SECRET="una-stringa-casuale-lunga"
# Letture al giorno per ogni invito (predefinito 20).
# LIMITE_GIORNALIERO=20
# Modello di Claude (predefinito claude-sonnet-5-5).
# CLAUDE_MODEL="claude-sonnet-5-5"
